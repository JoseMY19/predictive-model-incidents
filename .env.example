# Copy to .env and fill in. NEVER commit the real .env.

# PostgreSQL used by the pipeline. scripts/db_start.ps1 creates a dedicated local cluster and writes this for you.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5433/incidencias_pred
PG_PORT=5433

# Live sync with the production incident API (read-only: only GET + login). Leave empty to disable.
INCIDENCIAS_API_URL=http://<host>:<port>/api/v1
INCIDENCIAS_API_USER=
INCIDENCIAS_API_PASSWORD=
# Alternative for quick tests (short-lived JWT):
# INCIDENCIAS_API_TOKEN=

# Optional: import the real municipal cameras (python -m app.camaras_remote)
SIVECAM_API_URL=
SIVECAM_API_USER=
SIVECAM_API_PASSWORD=

# Optional: extra camera file(s) in addition to geo/camaras_municipales.json
# CAMARAS_JSON=
